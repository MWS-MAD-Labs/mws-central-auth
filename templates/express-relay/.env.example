# Paste the block Central shows when you connect the application (Application Access, Connect).
HUB_SSO_APP_ID=my-new-app
CENTRAL_ORGANIZATION_ID=org_my_new_app_xxxxxxxxxxxxxxxxxxxx
HUB_BASE_URL=http://localhost:5175
HUB_SSO_JWKS_URL=http://localhost:5175/.well-known/jwks.json
HUB_INTERNAL_SECRET=

# Only this app.
PORT=3100
# Signs this app's own session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
