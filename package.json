{
  "name": "mws-central-auth",
  "version": "0.4.0",
  "description": "Shared building blocks for MWS apps that integrate with the central identity system: reusable status/error UI (mws-central-auth) plus Hub SSO relay-token verification (mws-central-auth/server).",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts --format esm,cjs --dts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "zod": ">=4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MWS-MAD-Labs/mws-central-auth.git"
  },
  "dependencies": {
    "framer-motion": "^13.1.0"
  }
}
